# 1. Manual/Interactive viewing (Opens Chrome when launching attachment explicitly)
text/html; google-chrome %s; test=test -n "$DISPLAY"; nametemplate=%s.html

# 2. Automatic inline rendering for the NeoMutt pager (Uses Lynx)
text/html; lynx -dump -force_html -width=${COLUMNS:-80} %s; copiousoutput;

# Plain text
text/plain; nvim %s
