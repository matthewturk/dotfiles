# paths

source "~/.mutt/lang_en_US"

#set folder = "~/Mail/uiuc"
set imap_user = "`lpass show 2971987286 --user`"
set imap_pass = "`lpass show 2971987286 --password`"
set folder = imaps://outlook.office365.com/
set header_cache = "~/.mutt/cache/headers"
set message_cachedir = "~/.mutt/cache/bodies"
set certificate_file = "/etc/ssl/certs/ca-certificates.crt"
set mailcap_path = "~/.mutt/mailcap"
set tmpdir = "~/.mutt/tmp"
set spoolfile = "+Inbox"
# Lightning-fast local search (Sender, Recipient, Subject only)
set simple_search="~f %s | ~t %s | ~s %s"
# Quick macro to do a deep server-side body search with 'S'
macro index S "<limit>=b " "Server-side body search"
unset mail_check_stats

set wait_key = no
set mbox_type = Maildir
set timeout = 3
set mail_check = 0

set quit
set thorough_search
set mail_check_stats
unset confirmappend
unset move
unset mark_old
unset beep_new

set nosidebar_visible

set realname="Matthew Turk"
set from="$imap_user"
set sort=threads
set sort_aux = reverse-last-date-received
set meta_key=yes
set nomark_old # Don't mark as old

bind browser <return> view-file

set status_chars  = " *%A"
set status_format = "───[ Folder: %f ]───[%r%m messages%?n? (%n new)?%?d? (%d to delete)?%?t? (%t tagged)? ]───%>─%?p?( %p postponed )?───"

#source ~/.mutt/mutt-colors-solarized-dark-256.muttrc
#source ~/.mutt/mutt-colors-solarized-light-256.muttrc
#source ~/.mutt/colors-gruvbox-shuber.muttrc
#source ~/.mutt/mutt-colors-neonwolf-256.muttrc
#source ~/.mutt/vombatidae.neomuttrc
#source ~/.mutt/zenburn.neomuttrc
#source ~/.mutt/monokai.muttrc
source ~/.mutt/ayu-dark-256.neomuttrc

# Some overrides of colors for getting my attention
# Highlight unread messages vividly
color index brightyellow default "~N"
color index brightyellow default "~O"

# Highlight messages sent directly to YOU (not a mailing list or CC)
color index brightmagenta default "!~p"

# Highlight flagged/starred messages (for items needing action today)
color index brightred default "~F"

# Dim read/archived messages so they fade into the background
color index color240 default "~R !~F"

# Server name: smtp.office365.com
# Port: 587
# Encryption method: STARTTLS
set smtp_pass = $imap_pass
set smtp_url  = "smtp://$imap_user@smtp.office365.com:587/"
set ssl_force_tls = yes
set imap_authenticators = "xoauth2"
set imap_oauth_refresh_command = "~/.local/bin/mutt_oauth2.py ~/.mutt/tmp/TOKEN_FILENAME"
set smtp_authenticators=${imap_authenticators}
set smtp_oauth_refresh_command = ${imap_oauth_refresh_command}

# Setup some folders

set postponed= +$my_drafts_noquote
set record= +$my_sent_noquote
set trash= +$my_trash_noquote

set imap_check_subscribed="yes"
set imap_list_subscribed="yes"
set timeout=15
set mail_check=90
set imap_keepalive=180
set imap_idle
#set imap_deflate="yes"

set smart_wrap="yes"
alternative_order text/plain text/enriched text/html
auto_view text/html
# Pipe the current email body to urlscan
macro pager B "<pipe-entry>urlscan<enter>" "Open urlscan to navigate links"
macro index B "<pipe-entry>urlscan<enter>" "Open urlscan to navigate links"

# Unbind default version popup on 'V'
bind index,pager V noop

# Press 'V' to jump to HTML attachment and launch in Chrome
macro pager V "<view-attachments><search>text/html<enter><view-attach><exit>" "Open HTML in browser"
macro index V "<display-message><view-attachments><search>text/html<enter><view-attach><exit>" "Open HTML in browser"

# Some focus improvements, I think...

# Automatically collapse all threads when opening a folder
set collapse_unread = no       # Keep threads with unread messages expanded
set uncollapse_jump = yes      # Jump to unread message when uncollapsing

bind    index   G   imap-fetch-mail
bind    index   g   noop
macro   index   gi "<change-folder>=INBOX<enter>"       "Go to Inbox"
macro   index   gs "<change-folder>=$my_sent<enter>"    "Go to Sent"
macro   index   gd "<change-folder>=$my_drafts<enter>"  "Go to Drafts"
macro   index   gt "<change-folder>=$my_trash<enter>"   "Go to Trash"
macro   index   ga "<change-folder>=$my_trash<enter>"   "Go to Archive"

bind    index   <up>        previous-entry
bind    index   <down>      next-entry
bind    index   <delete>    delete-message
bind    index   -           collapse-thread
bind    index   _           collapse-all

bind    pager   b           previous-page
bind    pager   f           next-page

bind    index   x           tag-thread
macro   index   e           "<tag-prefix><delete-message>" "Archive Selected"

bind    index,pager   \CO           sidebar-toggle-visible
bind    index   \CP         sidebar-prev
bind    index   \CN         sidebar-next
bind    index   \C <enter>   sidebar-open

set mailcap_path = ~/.mutt/mailcap


# See https://neomutt.org/feature/cond-date
#
# The default index_format is:
#       '%4C %Z %{%b %d} %-15.15L (%?l?%4l&%4c?) %s'
#
# We replace the date field '%{%b %d}', giving:
#set index_format='%4C %Z %<[y?%<[m?%<[d?%[%H:%M ]&%[%a %d]>&%[%b %d]>&%[%m/%y ]> %-15.15L (%?l?%4l&%4c?) %s'
set index_format='%4C %Z %<[y?%<[m?%<[d?%[%H:%M ]&%[%a %d]>&%[%b %d]>&%[%m/%y ]> %-20.20F (%?l?%4l&%4c?) %s'
# Test  Date Range  Format String  Example
# --------------------------------------------
# %[d   Today       %[%H:%M ]      12:34
# %[m   This month  %[%a %d]       Thu 12
# %[y   This year   %[%b %d]       Dec 10
#  —    Older       %[%m/%y ]      06/15

set display_filter = '$HOME/.local/bin/unproofpoint'

source ~/.mutt/aliases
set alias_file=~/.mutt/aliases

# Eternal September
set news_server="news://news.eternal-september.org"
set nntp_user="`lpass show 8628485982867322757 --user`"
set nntp_pass="`lpass show 8628485982867322757 --password`"
set nntp_poll = 60
set nntp_authenticators=user
set catchup_newsgroup = ask-no
set nntp_listgroup = yes
set nntp_load_description = yes
set news_cache_dir="~/.mutt/news/"

#set folder="$news_server"
