{
  "interface_scale": {{ .blender.ui_scale }},
  "render_device_type": "{{ .blender.device }}",
  "theme": "Deep Grey",
  "asset_libraries": [
    {
      "name": "Personal Assets",
      "path": "{{ .chezmoi.homeDir }}/blender-assets/",
      "import_method": "LINK" 
    }
  ],
  "extensions": [
    "sun_position",
    "screencast_keys",
    "node_arrange",
    "node_wrangler",
    "csv_importer",
    "Quick_Asset_Saver"
  ],
  "input": {
      "ndof_translation_sensitivity": 2.0,
      "ndof_rotation_sensitivity": 2.0,
      "ndof_deadzone": 0.0,
      "ndof_zoom_direction": "NDOF_ZOOM_FORWARD",
      "ndof_show_guide_orbit_axis": false,
      "ndof_show_guide_orbit_center": true,
      "ndof_navigation_mode": "OBJECT",
      "ndof_lock_horizon": true,
      "ndof_fly_speed_auto": false,
      "ndof_orbit_center_auto": true,
      "ndof_orbit_center_selected": false,
      "ndof_rotx_invert_axis": true,
      "ndof_roty_invert_axis": true,
      "ndof_rotz_invert_axis": true,
      "ndof_panx_invert_axis": true,
      "ndof_pany_invert_axis": true,
      "ndof_panz_invert_axis": true,
      "ndof_fly_helicopter": false,
      "ndof_lock_camera_pan_zoom": true
  }
}
